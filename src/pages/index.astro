  .prog{background:var(--paper);border:1px solid var(--line);border-radius:12px;padding:30px;display:flex;flex-direction:column}
  .prog .step{font-family:'Inter';font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;color:var(--gold);font-weight:600}
  .prog h3{font-size:1.5rem;margin:8px 0 6px}
