  .hero-cta{display:flex;gap:13px;flex-wrap:wrap;align-items:center}
  .hero-note{margin-top:22px;font-size:.84rem;color:var(--sage);font-weight:600;letter-spacing:.02em}
  .portrait{aspect-ratio:4/4.8;max-width:315px;border-radius:8px;overflow:hidden;position:relative;box-shadow:0 26px 60px -30px rgba(90,60,40,.45)}
