---
import '../styles/global.css';
import { firm, hero, pillars, turn, audiences, why, steps, closing, footerLine } from '../data/site.js';
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Triplicity — Leadership & Transition Coaching</title>
  <meta name="description" content="Triplicity is presence-led coaching and leadership for leaders, couples, and partnerships in transition. A Vault Human company." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..600;1,9..144,300..500&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  <!-- Google Ads gtag (AW-18371546487) + HubSpot conversion listener -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=AW-18371546487"></script>
  <script>
    window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}
    gtag('js',new Date());gtag('config','AW-18371546487');
    window.addEventListener('message',function(e){if(e&&e.data&&e.data.type==='hsFormCallback'&&e.data.eventName==='onFormSubmitted'){gtag('event','conversion',{send_to:'AW-18371546487/r4eECOKGw9wcEPeanrhE'});gtag('event','generate_lead');}});
  </script>
  <style>
    .coachcard{display:flex;flex-direction:column;align-items:center;text-align:center;gap:12px;margin:0 auto 22px}
    .coachcard img{width:120px;height:150px;object-fit:cover;border-radius:12px;filter:grayscale(1)}
    .coachname{font-weight:600;margin:0}
    .coachrole{opacity:.7;margin:2px 0 0;font-size:14px}
  </style>
</head>
<body>
  <header class="site">
    <div class="wrap bar">
      <a class="brand" href="/">{firm.wordmark}</a>
      <a class="navbtn" href="#" data-open-form>Start a conversation</a>
    </div>
  </header>
  <main>
    <div class="wrap">
      <section class="hero">
        <p class="kicker">{firm.kicker}</p>
        <h1>{hero.h1}</h1>
        <p class="subline serif">{hero.subline}</p>
      </section>
      <div class="lede">{hero.lede.map((p) => <p>{p}</p>)}</div>
      <div class="cta"><a class="btn-fill" href="#" data-open-form>{hero.cta}</a></div>

      <hr class="rule" />
      <h2 class="sec">The 360 — eight parts of a whole life</h2>
      <section class="cols" style="display:grid;grid-template-columns:repeat(4,1fr);gap:22px">{pillars.map((c) => (<div><h3>{c.title}</h3><p>{c.body}</p></div>))}</section>
      <p class="turn" style="text-align:center;margin-top:20px;opacity:.85">Eight parts — because eight, turned on its side, is infinity. A whole life, without end.</p>

      <hr class="rule" />
      <p class="turn">{turn}</p>

      <hr class="rule" />
      <h2 class="sec">Who we work with</h2>
      <div class="tags">{audiences.map((t) => <span class="tag">{t}</span>)}</div>

      <hr class="rule" />
      <h2 class="sec">Why {firm.name}</h2>
      <div class="coachcard">
        <img src="/russ-bw.jpg" alt="Russ Michaels, founder of Triplicity Advisory" width="120" height="150" />
        <div><p class="coachname">Russ Michaels, Esq.</p><p class="coachrole">Founder &middot; Triplicity Advisory</p></div>
      </div>
      <div class="prose">{why.map((p) => <p>{p}</p>)}</div>

      <hr class="rule" />
      <h2 class="sec">The Space Between</h2>
      <ol class="steps">{steps.map((s) => (<li><span class="rn">{s.n}</span><b>{s.title}</b> {s.body}</li>))}</ol>

      <hr class="rule" />
      <p class="closing">{closing}</p>
      <div class="ctarow" id="start"><a class="btn-fill" href="#" data-open-form>{hero.cta}</a></div>
    </div>
  </main>
  <div class="vh-ribbon" style="text-align:center;padding:22px 16px;border-top:1px solid rgba(139,146,153,.22)"><a href="https://www.vaulthuman.com" style="color:#8B9299;text-decoration:none;font:500 14px/1.6 Inter,system-ui,sans-serif;letter-spacing:.03em">One seat. Your whole life. <strong style="color:#8B9299">Vault Human.</strong></a></div>
  <footer class="site">
    <div class="wrap">
      <p class="sig">{firm.legalName.toUpperCase()}</p>
      <p class="meta">{footerLine} &middot; <a href="tel:+18888332510">(888)&nbsp;833-2510</a> &middot; &copy; {year}</p>
      <p class="backlink">A member of the <a href="https://www.vaulthuman.com">Vault Human</a> family of companies.</p>
    </div>
  </footer>

  <!-- Start-a-conversation modal -->
  <div id="vh-modal" class="vh-modal" aria-hidden="true">
    <div class="vh-modal__bg" data-close-form></div>
    <div class="vh-modal__card" role="dialog" aria-modal="true" aria-label="Start a conversation">
      <button class="vh-modal__x" type="button" data-close-form aria-label="Close">&times;</button>
      <h2 class="vh-modal__title">Start a conversation</h2>
      <p class="vh-modal__sub">A few lines about where you are and what&rsquo;s shifting &mdash; no pressure.</p>
      <div class="hs-form-frame" data-region="na2" data-form-id="3f225ab5-5a70-46d9-a497-29e6256b1e52" data-portal-id="246947446"></div>
    </div>
  </div>
  <script is:inline src="https://js-na2.hsforms.net/forms/embed/246947446.js" defer></script>
  <script is:inline>
  (function(){var m=document.getElementById('vh-modal');if(!m)return;
  function o(e){if(e)e.preventDefault();m.classList.add('is-open');m.setAttribute('aria-hidden','false');document.documentElement.style.overflow='hidden';}
  function c(){m.classList.remove('is-open');m.setAttribute('aria-hidden','true');document.documentElement.style.overflow='';}
  document.addEventListener('click',function(e){var t=e.target.closest('[data-open-form]');if(t){o(e);return;}if(e.target.closest('[data-close-form]'))c();});
  document.addEventListener('keydown',function(e){if(e.key==='Escape')c();});})();
  </script>
<script>
addEventListener('DOMContentLoaded',function(){
 if(!('IntersectionObserver'in window))return;
 var s='main .wrap>section:not(.hero),main .wrap>h2,main .wrap>.prose,main .wrap>.lede,main .wrap>.cta,main .wrap>.ctarow,main .wrap>.turn,main .wrap>.closing,main .wrap>.why,main .wrap>.tags,main .wrap>.markets,main .wrap>.pkgs,main .wrap>.areas,main .wrap>.steps,main .wrap>.cols,main .wrap>.pagehead,main .wrap>.coachcard';
 var e=[].slice.call(document.querySelectorAll(s));
 e.forEach(function(x){x.classList.add('reveal')});
 var o=new IntersectionObserver(function(t){t.forEach(function(y){if(y.isIntersecting){y.target.classList.add('in');o.unobserve(y.target)}})},{threshold:0.06,rootMargin:'0px 0px -30px 0px'});
 e.forEach(function(x){o.observe(x)});
});
</script>

</body>
</html>
