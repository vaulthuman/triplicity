  h1{font-size:clamp(2.3rem,4.8vw,3.8rem)}
  h2{font-size:clamp(1.8rem,3.4vw,2.6rem)}
  a{color:inherit;text-decoration:none}
  .wrap{max-width:1140px;margin:0 auto;padding:0 26px}
  .eyebrow{font-family:'Inter';font-weight:600;letter-spacing:.16em;text-transform:uppercase;font-size:.72rem;color:var(--clay)}
  .btn{display:inline-block;padding:14px 30px;border-radius:40px;font-weight:600;font-size:.94rem;cursor:pointer;border:1.5px solid transparent;transition:.18s;font-family:'Inter'}
  .btn-primary{background:var(--clay);color:var(--paper)}
  .btn-primary:hover{background:var(--clay-deep)}
  .btn-ghost{background:transparent;color:var(--ink);border-color:var(--ink)}
  .btn-ghost:hover{background:var(--ink);color:var(--cream)}

  .util{background:var(--ink);color:#E8DFD0;font-size:.79rem;letter-spacing:.05em;text-align:center;padding:8px}
  .util b{color:var(--gold)}
  header{position:sticky;top:0;z-index:50;background:rgba(245,238,226,.92);backdrop-filter:blur(8px);border-bottom:1px solid var(--line)}
  .nav{display:flex;align-items:center;justify-content:space-between;height:72px}
  .brand{font-family:'Fraunces';font-size:1.55rem;font-weight:600;letter-spacing:.04em}
