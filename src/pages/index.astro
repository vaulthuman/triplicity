<style is:global>
  :root{
    --cream:#F5EEE2; --cream-2:#EDE3D3; --paper:#FBF7EF;
    --ink:#241F1A; --ink-soft:#5A5148;
    --clay:#B5623C;   /* warm primary accent */
    --clay-deep:#8F4A2C;
    --sage:#6E7A5E;   /* calm secondary */
    --gold:#B08D57;
    --line:#E0D4C0;
