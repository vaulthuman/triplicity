  .like .i{color:var(--gold);font-family:'Fraunces';font-size:1.6rem;margin-bottom:6px}
  @media(max-width:760px){.like-grid{grid-template-columns:1fr}}

  /* testimonials */
  .quotes{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:20px}
  .quote{background:var(--paper);border:1px solid var(--line);border-radius:12px;padding:26px}
  .quote p{font-family:'Fraunces';font-style:italic;font-size:1.08rem;color:var(--ink);margin-bottom:16px;line-height:1.4}
  .quote .who{display:flex;align-items:center;gap:11px}
  .quote .av{width:38px;height:38px;border-radius:50%;background:var(--cream-2);border:1px solid var(--line);display:flex;align-items:center;justify-content:center;font-family:'Fraunces';color:var(--sage)}
  .quote .who b{font-size:.9rem;display:block}
  .quote .who span{font-size:.78rem;color:var(--ink-soft)}
  .ph-note{text-align:center;font-size:.74rem;color:var(--ink-soft);margin-top:18px;font-style:italic}
  @media(max-width:760px){.quotes{grid-template-columns:1fr}}

  /* about */
  .about-grid{display:grid;grid-template-columns:.8fr 1.2fr;gap:46px;align-items:center}
  .about .portrait{aspect-ratio:1/1.05}
  .about h2{margin-bottom:16px}
  .about p{color:var(--ink-soft);margin-bottom:14px;max-width:52ch}
  .about .sig{font-family:'Fraunces';font-style:italic;font-size:1.15rem;color:var(--clay);margin-top:6px}
  @media(max-width:860px){.about-grid{grid-template-columns:1fr;gap:30px}}

  /* final */
  .final-grid{display:grid;grid-template-columns:1fr 1fr;gap:46px;align-items:start}
  form{background:var(--paper);border:1px solid var(--line);border-radius:14px;padding:28px}
  form label{display:block;font-size:.8rem;letter-spacing:.03em;margin-bottom:6px;color:var(--ink-soft);font-weight:600}
  form input,form select,form textarea{width:100%;padding:12px 14px;margin-bottom:15px;border-radius:8px;border:1px solid var(--line);background:#fff;font-family:inherit;font-size:.95rem;color:var(--ink)}
  form input:focus,form select:focus,form textarea:focus{outline:none;border-color:var(--clay)}
  form .btn-primary{width:100%;border:none}
  .disclaimer{font-size:.74rem;color:var(--ink-soft);margin-top:12px}
  @media(max-width:820px){.final-grid{grid-template-columns:1fr;gap:30px}}

  footer{background:var(--ink);color:#B6AC9B;padding:50px 0 28px;font-size:.86rem}
  .foot-grid{display:grid;grid-template-columns:1.5fr 1fr 1fr;gap:34px;margin-bottom:30px}
  footer .brand{color:var(--cream);margin-bottom:12px}
  footer a:hover{color:var(--gold)}
  footer h5{color:var(--cream);font-family:'Inter';font-size:.74rem;letter-spacing:.12em;text-transform:uppercase;margin-bottom:12px}
